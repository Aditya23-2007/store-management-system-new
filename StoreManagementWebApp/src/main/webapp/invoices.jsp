<%@page contentType="text/html" pageEncoding="UTF-8"%><%@include file="includes/auth.jsp"%><% request.setAttribute("activePage","invoices"); request.setAttribute("pageTitle","Invoice / Bill Scan Upload"); %>
<!DOCTYPE html><html><head><title>Invoices</title><%@include file="includes/header.jsp"%></head><body><div class="app"><%@include file="includes/sidebar.jsp"%><main class="main"><%@include file="includes/topbar.jsp"%>
<% if("1".equals(request.getParameter("uploaded"))){ %><div class="badge-green" style="display:inline-block;margin-bottom:14px">Invoice scanned copy uploaded and JSON metadata saved successfully.</div><% } %>
<div class="cat-layout"><div class="cat-form-card"><div class="modal-title">Upload Scanned Bill / Invoice</div><form action="invoiceUpload" method="post" enctype="multipart/form-data"><div class="form-group"><label>PO Number</label><select class="form-control" name="po_number"><% try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement(); java.sql.ResultSet rs=st.executeQuery("SELECT po_number FROM purchase_orders ORDER BY id DESC")){ while(rs.next()){ %><option><%=rs.getString("po_number")%></option><% }} catch(Exception e){} %></select></div><div class="form-group"><label>Invoice Number</label><input class="form-control" name="invoice_number" required></div><div class="form-group"><label>Supplier Name</label><select class="form-control" name="supplier_name"><% try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement(); java.sql.ResultSet rs=st.executeQuery("SELECT name FROM suppliers ORDER BY name")){ while(rs.next()){ %><option><%=rs.getString("name")%></option><% }} catch(Exception e){} %></select></div><div class="form-group"><label>Invoice Amount</label><input class="form-control" type="number" step="0.01" name="amount"></div><div class="form-group"><label>Payment Status</label><select class="form-control" name="payment_status"><option>Pending</option><option>Partial Payment</option><option>Paid</option></select></div><div class="form-group"><label>Upload Scanned Copy</label><input class="form-control" type="file" name="invoice_file" accept=".pdf,.jpg,.jpeg,.png" required><div class="file-note">Allowed: PDF, JPG, JPEG, PNG. File path and JSON metadata will be stored in database.</div></div><button class="btn-primary">Upload Invoice</button></form></div><div><div class="table-search" style="margin-bottom:16px"><span>🔍</span><input oninput="filterTable('invoice-table',this.value)" placeholder="Search invoices..."></div><div class="data-table"><table id="invoice-table"><thead><tr><th>ID</th><th>PO</th><th>Invoice</th><th>Supplier</th><th>Amount</th><th>Status</th><th>File</th><th>JSON</th></tr></thead><tbody><% try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement(); java.sql.ResultSet rs=st.executeQuery("SELECT * FROM invoice_documents ORDER BY id DESC")){ while(rs.next()){ %><tr><td><%=rs.getInt("id")%></td><td><%=rs.getString("po_number")%></td><td><%=rs.getString("invoice_number")%></td><td><%=rs.getString("supplier_name")%></td><td>₹<%=rs.getBigDecimal("invoice_amount")%></td><td><span class="badge-yellow"><%=rs.getString("payment_status")%></span></td><td><a class="action-link" target="_blank" href="<%=request.getContextPath()%>/<%=rs.getString("file_path")%>">View</a></td><td><textarea class="form-control" readonly style="min-width:260px;height:70px"><%=rs.getString("json_metadata")%></textarea></td></tr><% }} catch(Exception e){ %><tr><td colspan="8">Error: <%=e.getMessage()%></td></tr><% } %></tbody></table></div></div></div>
</main></div></body></html>
