<%@page contentType="text/html" pageEncoding="UTF-8"%><%@include file="includes/auth.jsp"%><% request.setAttribute("activePage","orders"); request.setAttribute("pageTitle","Orders / Billing"); %>
<!DOCTYPE html><html><head><title>Orders</title><%@include file="includes/header.jsp"%></head><body><div class="app"><%@include file="includes/sidebar.jsp"%><main class="main"><%@include file="includes/topbar.jsp"%><div class="table-toolbar"><div class="table-search"><span>🔍</span><input oninput="filterTable('orders-table',this.value)" placeholder="Search orders..."></div><a class="btn-primary" href="billing.jsp">+ New Bill</a></div><div class="data-table"><table id="orders-table"><thead><tr><th>Order ID</th><th>Customer</th><th>Product</th><th>Qty</th><th>Total</th><th>Date</th></tr></thead><tbody>
<% try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement(); java.sql.ResultSet rs=st.executeQuery("SELECT s.id,s.customer_name,p.name product,s.quantity,s.total_amount,s.sale_date FROM sales s LEFT JOIN products p ON s.product_id=p.id ORDER BY s.id DESC")){ boolean any=false; while(rs.next()){ any=true; %><tr><td><%=rs.getInt("id")%></td><td><%=rs.getString("customer_name")%></td><td><%=rs.getString("product")%></td><td><%=rs.getInt("quantity")%></td><td>₹<%=rs.getBigDecimal("total_amount")%></td><td><%=rs.getTimestamp("sale_date")%></td></tr><% } if(!any){ %><tr><td colspan="6" class="empty-state"><div class="empty-state-icon">🛒</div><b>No orders yet</b><br>Generated bills will appear here.</td></tr><% }} catch(Exception e){ %><tr><td colspan="6">Error: <%=e.getMessage()%></td></tr><% } %>
</tbody></table></div></main></div></body></html>
