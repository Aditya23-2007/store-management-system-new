<%@page contentType="text/html" pageEncoding="UTF-8"%><%@include file="includes/auth.jsp"%><% request.setAttribute("activePage","approvals"); request.setAttribute("pageTitle","Approvals"); %>
<!DOCTYPE html><html><head><title>Approvals</title><%@include file="includes/header.jsp"%></head><body><div class="app"><%@include file="includes/sidebar.jsp"%><main class="main"><%@include file="includes/topbar.jsp"%><div class="cat-layout"><div class="cat-form-card"><div class="modal-title">Approve / Reject Requirement</div><form action="approvals" method="post"><div class="form-group"><label>Requirement</label><select class="form-control" name="requirement_id"><% try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement(); java.sql.ResultSet rs=st.executeQuery("SELECT id,item_name,status FROM requirements ORDER BY id DESC")){ while(rs.next()){ %><option value="<%=rs.getInt("id")%>">#<%=rs.getInt("id")%> - <%=rs.getString("item_name")%> (<%=rs.getString("status")%>)</option><% }} catch(Exception e){} %></select></div><div class="form-group"><label>Approved By</label><input class="form-control" name="approved_by" value="Director" required></div><div class="form-group"><label>Status</label><select class="form-control" name="approval_status"><option>Approved</option><option>Rejected</option><option>Pending</option></select></div><div class="form-group"><label>Remarks</label><textarea class="form-control textarea" name="remarks"></textarea></div><button class="btn-primary">Save Approval</button></form></div><div><div class="data-table"><table><thead><tr><th>ID</th><th>Requirement</th><th>By</th><th>Status</th><th>Date</th><th>Remarks</th></tr></thead><tbody><% try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement(); java.sql.ResultSet rs=st.executeQuery("SELECT a.*,r.item_name FROM approvals a LEFT JOIN requirements r ON a.requirement_id=r.id ORDER BY a.id DESC")){ while(rs.next()){ %><tr><td><%=rs.getInt("id")%></td><td><%=rs.getString("item_name")%></td><td><%=rs.getString("approved_by")%></td><td><span class="badge-green"><%=rs.getString("approval_status")%></span></td><td><%=rs.getDate("approval_date")%></td><td><%=rs.getString("remarks")%></td></tr><% }} catch(Exception e){ %><tr><td colspan="6">Error: <%=e.getMessage()%></td></tr><% } %></tbody></table></div></div></div></main></div></body></html>
