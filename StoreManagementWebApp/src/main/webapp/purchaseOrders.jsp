<%@page contentType="text/html" pageEncoding="UTF-8"%><%@include file="includes/auth.jsp"%><% request.setAttribute("activePage","po"); request.setAttribute("pageTitle","Purchase Orders"); %>
<!DOCTYPE html><html><head><title>Purchase Orders</title><%@include file="includes/header.jsp"%></head><body><div class="app"><%@include file="includes/sidebar.jsp"%><main class="main"><%@include file="includes/topbar.jsp"%><div class="cat-layout"><div class="cat-form-card"><div class="modal-title">Generate Purchase Order</div><form action="purchaseOrders" method="post"><div class="form-group"><label>PO Number</label><input class="form-control" name="po_number" value="PO-2026-" required></div><div class="form-group"><label>Approved Requirement</label><select class="form-control" name="requirement_id"><% try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement(); java.sql.ResultSet rs=st.executeQuery("SELECT id,item_name FROM requirements WHERE status='Approved' ORDER BY id DESC")){ while(rs.next()){ %><option value="<%=rs.getInt("id")%>">#<%=rs.getInt("id")%> - <%=rs.getString("item_name")%></option><% }} catch(Exception e){} %></select></div><div class="form-group"><label>Supplier</label><select class="form-control" name="supplier_name"><% try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement(); java.sql.ResultSet rs=st.executeQuery("SELECT name FROM suppliers ORDER BY name")){ while(rs.next()){ %><option><%=rs.getString("name")%></option><% }} catch(Exception e){} %></select></div><div class="form-group"><label>Total Amount</label><input class="form-control" type="number" step="0.01" name="total_amount"></div><button class="btn-primary">Generate PO</button></form></div><div><div class="data-table"><table><thead><tr><th>PO No.</th><th>Requirement</th><th>Supplier</th><th>Date</th><th>Amount</th><th>Status</th></tr></thead><tbody><% try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement(); java.sql.ResultSet rs=st.executeQuery("SELECT po.*,r.item_name FROM purchase_orders po LEFT JOIN requirements r ON po.requirement_id=r.id ORDER BY po.id DESC")){ while(rs.next()){ %><tr><td><%=rs.getString("po_number")%></td><td><%=rs.getString("item_name")%></td><td><%=rs.getString("supplier_name")%></td><td><%=rs.getDate("po_date")%></td><td>₹<%=rs.getBigDecimal("total_amount")%></td><td><%=rs.getString("po_status")%></td></tr><% }} catch(Exception e){ %><tr><td colspan="6">Error: <%=e.getMessage()%></td></tr><% } %></tbody></table></div></div></div></main></div></body></html>
