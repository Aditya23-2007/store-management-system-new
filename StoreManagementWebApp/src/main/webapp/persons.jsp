<%@ page import="java.util.*,com.store.model.Person" %><%@ page contentType="text/html;charset=UTF-8" %>
<html><head><title>People</title><link rel="stylesheet" href="assets/css/style.css"></head><body><jsp:include page="header.jsp"/><div class="container"><% String type=(String)request.getAttribute("type"); %><h2><%= type.substring(0,1).toUpperCase()+type.substring(1) %> Management</h2><div class="card"><form method="post" action="<%=type%>"><label>Name</label><input name="name" required><label>Phone</label><input name="phone"><label>Email</label><input name="email"><label>Address</label><textarea name="address"></textarea><button>Add</button></form></div><table><tr><th>ID</th><th>Name</th><th>Phone</th><th>Email</th><th>Address</th><th>Action</th></tr><% for(Person p:(List<Person>)request.getAttribute("persons")){ %><tr><td><%=p.getId()%></td><td><%=p.getName()%></td><td><%=p.getPhone()%></td><td><%=p.getEmail()%></td><td><%=p.getAddress()%></td><td><a class="btn danger" href="<%=type%>?delete=<%=p.getId()%>" onclick="return confirm('Delete record?')">Delete</a></td></tr><% } %></table></div></body></html>
