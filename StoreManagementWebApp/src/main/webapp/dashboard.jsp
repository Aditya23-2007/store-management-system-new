<%@page contentType="text/html" pageEncoding="UTF-8"%><%@include file="includes/auth.jsp"%><% request.setAttribute("activePage","dashboard"); request.setAttribute("pageTitle","Dashboard"); %>
<!DOCTYPE html><html><head><title>Dashboard</title><%@include file="includes/header.jsp"%></head><body><div class="app"><%@include file="includes/sidebar.jsp"%><main class="main"><%@include file="includes/topbar.jsp"%>
<% int totalProducts=0,totalStock=0,pendingReq=0,pendingPay=0; String outName="None", highName="None", highCat="-"; int highSold=0; try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement()){ java.sql.ResultSet rs=st.executeQuery("SELECT COUNT(*) c, COALESCE(SUM(quantity),0) s FROM products"); rs.next(); totalProducts=rs.getInt("c"); totalStock=rs.getInt("s"); rs=st.executeQuery("SELECT COUNT(*) c FROM requirements WHERE status='Pending'"); rs.next(); pendingReq=rs.getInt("c"); rs=st.executeQuery("SELECT COUNT(*) c FROM invoice_documents WHERE payment_status<>'Paid'"); rs.next(); pendingPay=rs.getInt("c"); rs=st.executeQuery("SELECT name FROM products WHERE quantity=0 LIMIT 1"); if(rs.next()) outName=rs.getString(1); rs=st.executeQuery("SELECT p.name,p.category,COALESCE(SUM(s.quantity),0) sold FROM products p LEFT JOIN sales s ON p.id=s.product_id GROUP BY p.id,p.name,p.category ORDER BY sold DESC LIMIT 1"); if(rs.next()){ highName=rs.getString("name"); highCat=rs.getString("category"); highSold=rs.getInt("sold"); } } catch(Exception e){} %>
<div class="stat-grid"><div class="stat-card"><div class="stat-icon blue">📦</div><div><div class="stat-label">Total Products</div><div class="stat-value"><%=totalProducts%></div></div></div><div class="stat-card"><div class="stat-icon green">🏬</div><div><div class="stat-label">Total Stock</div><div class="stat-value"><%=totalStock%></div></div></div><div class="stat-card"><div class="stat-icon orange">📝</div><div><div class="stat-label">Pending Requirements</div><div class="stat-value"><%=pendingReq%></div></div></div><div class="stat-card"><div class="stat-icon purple">💰</div><div><div class="stat-label">Pending Payments</div><div class="stat-value"><%=pendingPay%></div></div></div></div>
<div class="dash-panels"><div class="panel-card"><div class="panel-header"><span class="panel-title">Out of Stock Products</span><a class="view-all" href="products.jsp">View All</a></div><div class="out-of-stock-item"><span><%=outName%></span><span class="badge-red">Out of Stock</span></div></div><div class="panel-card"><div class="panel-header"><span class="panel-title">Highest Sale Product</span><a class="view-all" href="orders.jsp">View All</a></div><div class="info-grid"><div class="info-box"><div class="info-box-label">Name</div><div class="info-box-value"><%=highName%></div></div><div class="info-box"><div class="info-box-label">Category</div><div class="info-box-value"><%=highCat%></div></div></div><div class="info-box"><div class="info-box-label">Total Units Sold</div><div class="info-box-value"><%=highSold%></div></div></div><div class="panel-card"><div class="panel-header"><span class="panel-title">Low Stock Products</span><a class="view-all" href="products.jsp">View All</a></div><% try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement(); java.sql.ResultSet rs=st.executeQuery("SELECT name,quantity FROM products WHERE quantity BETWEEN 1 AND 5 ORDER BY quantity ASC LIMIT 5")){ while(rs.next()){ %><div class="low-stock-item"><span><%=rs.getString("name")%></span><span class="badge-yellow"><%=rs.getInt("quantity")%> left</span></div><% }} catch(Exception e){} %></div></div>
</main></div></body></html>
