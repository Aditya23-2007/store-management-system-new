<%@page contentType="text/html" pageEncoding="UTF-8"%><%@include file="includes/auth.jsp"%><% request.setAttribute("activePage","payments"); request.setAttribute("pageTitle","Payments"); %>
<!DOCTYPE html><html><head><title>Payments</title><%@include file="includes/header.jsp"%></head><body><div class="app"><%@include file="includes/sidebar.jsp"%><main class="main"><%@include file="includes/topbar.jsp"%><div class="cat-layout"><div class="cat-form-card"><div class="modal-title">Update Payment Status</div><form action="payments" method="post"><div class="form-group"><label>Invoice Document</label><select class="form-control" name="invoice_document_id"><% try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement(); java.sql.ResultSet rs=st.executeQuery("SELECT id,invoice_number,supplier_name FROM invoice_documents ORDER BY id DESC")){ while(rs.next()){ %><option value="<%=rs.getInt("id")%>">#<%=rs.getInt("id")%> - <%=rs.getString("invoice_number")%> - <%=rs.getString("supplier_name")%></option><% }} catch(Exception e){} %></select></div><div class="form-group"><label>Supplier</label><input class="form-control" name="supplier_name" required></div><div class="form-group"><label>Paid Amount</label><input class="form-control" type="number" step="0.01" name="paid_amount"></div><div class="form-group"><label>Status</label><select class="form-control" name="payment_status"><option>Pending</option><option>Partial Payment</option><option>Paid</option></select></div><div class="form-group"><label>Transaction Reference</label><input class="form-control" name="transaction_reference"></div><div class="form-group"><label>Remarks</label><textarea class="form-control textarea" name="remarks"></textarea></div><button class="btn-primary">Save Payment</button></form></div><div><div class="data-table"><table><thead><tr><th>ID</th><th>Invoice</th><th>Supplier</th><th>Amount</th><th>Status</th><th>Date</th><th>Reference</th></tr></thead><tbody><% try(java.sql.Connection con=com.store.util.DBConnection.getConnection(); java.sql.Statement st=con.createStatement(); java.sql.ResultSet rs=st.executeQuery("SELECT p.*,i.invoice_number FROM payments p LEFT JOIN invoice_documents i ON p.invoice_document_id=i.id ORDER BY p.id DESC")){ while(rs.next()){ %><tr><td><%=rs.getInt("id")%></td><td><%=rs.getString("invoice_number")%></td><td><%=rs.getString("supplier_name")%></td><td>₹<%=rs.getBigDecimal("paid_amount")%></td><td><%=rs.getString("payment_status")%></td><td><%=rs.getDate("payment_date")%></td><td><%=rs.getString("transaction_reference")%></td></tr><% }} catch(Exception e){ %><tr><td colspan="7">Error: <%=e.getMessage()%></td></tr><% } %></tbody></table></div></div></div></main></div></body></html>
